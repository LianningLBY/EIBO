sources:
  - id: cherubin-bayes-not-naive
    title: "Bayes, not Naïve: Security Bounds on Website Fingerprinting Defenses"
    authors: "Giovanni Cherubin"
    venue: "Proceedings on Privacy Enhancing Technologies, 2017"
    year: 2017
    url: "https://doi.org/10.1515/popets-2017-0046"
    category: theory-foundation
    role: theory-foundation
    relevance: "Provides feature-set-conditional Bayes-error bounds for website fingerprinting. EIBO uses this as the closed-set information-limit precedent that motivates pairwise error floors."
    verification_status: verified-abstract
    notes: "The DOI landing page was not directly readable, but the PoPETs/arXiv record for the same paper was fetched and verified."

  - id: liu-side-channel-leakage
    title: "The Inevitability of Side-Channel Leakage in Encrypted Traffic"
    authors: "Guangjie Liu; Guang Cheng; Weiwei Liu"
    venue: "arXiv, 2026"
    year: 2026
    url: "https://arxiv.org/abs/2602.14055"
    arxiv_id: "2602.14055"
    category: theory-foundation
    role: theory-foundation
    relevance: "Establishes a positive mutual-information side-channel existence theorem for encrypted traffic under explicit non-degeneracy and distinguishability conditions. EIBO uses it as the single-letter/i.i.d. positioning baseline against which dependent packet-prefix laws are tested."
    verification_status: verified-abstract
    notes: "The abstract verifies the existence theorem and positive-information claim. Full HTML Section 5.1 verifies that additivity and exponential error decay require conditionally i.i.d. repeated observations; no broader multi-letter open-problem claim is used."

  - id: liu-rate-distortion-side-channel
    title: "Rate-Distortion Function for Encrypted Traffic Side-Channel Defense"
    authors: "Guangjie Liu; Guang Cheng; Weiwei Liu; Yutong Wang"
    venue: "arXiv, 2026"
    year: 2026
    url: "https://arxiv.org/abs/2607.17889"
    arxiv_id: "2607.17889"
    category: theory-foundation
    role: theory-foundation
    relevance: "Characterizes a side-channel rate-distortion function and an exact leakage-cost Pareto frontier within a stationary-memoryless defense class. EIBO uses this as the verified Theta_iid comparator, while extending attention to dependent QUIC prefixes."
    verification_status: verified-abstract
    notes: "The abstract explicitly restricts the result to Theta_iid and states exact-frontier-within-Theta_iid. It does not need to support any claim about an open problem outside that class."

  - id: michel-high-probability-tv
    title: "High Probability Lower Bounds for the Total Variation Distance"
    authors: "Loris Michel; Jeffrey Näf; Nicolai Meinshausen"
    venue: "arXiv, 2020"
    year: 2020
    url: "https://arxiv.org/abs/2005.06006"
    arxiv_id: "2005.06006"
    category: lower-bound-method
    role: method-component
    relevance: "Develops classifier- and projection-based high-probability lower bounds on total variation distance. EIBO consumes the sup-over-cutoff construction for the assumption-free epsilon_k lower bracket, which certifies distinguishability rather than an error floor."
    verification_status: verified-abstract
    notes: "The fetched arXiv record identifies an arXiv preprint; a peer-reviewed publication venue was not verified."

  - id: tao-discriminative-tv
    title: "Discriminative Estimation of Total Variation Distance: A Fidelity Auditor for Generative Data"
    authors: "Lan Tao; Shirong Xu; Chi-Hua Wang; Namjoon Suh; Guang Cheng"
    venue: "arXiv, 2024"
    year: 2024
    url: "https://arxiv.org/abs/2405.15337"
    arxiv_id: "2405.15337"
    category: tv-estimation
    role: method-component
    relevance: "Relates discriminative estimation of total variation to Bayes classification risk and studies convergence under a specified hypothesis class, including Gaussian examples. EIBO uses it as a triangulation estimator between discrete plug-in bounds and larger-k model-based estimates."
    verification_status: verified-abstract
    notes: "The fetched record says Fidelity Auditor for Generative Data, not the brief's Fidelity Estimator for Generative Models. Its abstract does not provide a distribution-free upper confidence bound for EIBO."

  - id: orlitsky-unseen-species
    title: "Optimal prediction of the number of unseen species"
    authors: "Alon Orlitsky; Ananda Theertha Suresh; Yihong Wu"
    venue: "Proceedings of the National Academy of Sciences, 2016"
    year: 2016
    url: "https://doi.org/10.1073/pnas.1607774113"
    category: theory-foundation
    role: theory-foundation
    relevance: "Provides the classical unseen-species framework for predicting future unseen mass from occupancy counts. EIBO uses it as the Good-Toulmin/missing-service-mass foundation for deployment-site open-set uncertainty."
    verification_status: verified-abstract
    notes: "The DOI-associated PNAS record was resolved through the web search/fetch workflow; the source is used for the unseen-species method, not as evidence for QUIC-specific sampling."

  - id: eriksson-unseen-species-revisited
    title: "The Unseen Species Problem Revisited"
    authors: "Edward Eriksson"
    venue: "arXiv, 2026"
    year: 2026
    url: "https://arxiv.org/abs/2602.08769"
    arxiv_id: "2602.08769"
    category: theory-foundation
    role: theory-foundation
    relevance: "Develops prediction intervals and finite-sample guarantees for unseen-species prediction, including Good-Toulmin and incidence-data extensions. EIBO uses it to attach prediction intervals to the site-specific missing-service-mass term."
    verification_status: verified-abstract
    notes: "The arXiv record shows v1 submitted 2026-02-09 and v4 revised 2026-09-09, matching the brief's v4 date."

  - id: zhao-sweet-danger-sugar
    title: "The Sweet Danger of Sugar: Debunking Representation Learning for Encrypted Traffic Classification"
    authors: "Yuqi Zhao; Giovanni Dettori; Matteo Boffa; Luca Vassio; Marco Mellia"
    venue: "ACM SIGCOMM, 2025"
    year: 2025
    url: "https://doi.org/10.1145/3718958.3750498"
    category: hygiene-shortcut
    role: context
    relevance: "Shows that representation-learning performance in encrypted traffic classification can be driven by shortcut features and leakage-prone data organization. EIBO uses it to require flow- and time-disjoint evaluation and to prohibit packet-level splitting."
    verification_status: verified-abstract
    notes: "An arXiv version of the paper was fetched; the ACM DOI landing page itself was not directly readable."

  - id: zhao-shortcutcatcher
    title: "ShortcutCatcher: Making Traffic Classification Reliable"
    authors: "Yuqi Zhao; Matteo Boffa; Luca Vassio; Marco Mellia"
    venue: "Proceedings of the ACM on Networking (CoNEXT), 2026"
    year: 2026
    url: "https://doi.org/10.1145/3808671"
    category: hygiene-shortcut
    role: context
    relevance: "Targets shortcut-induced unreliability in traffic classification and motivates systematic address-field randomization and shortcut audits. EIBO uses it for the mandated DST_IP, DST_ASN, DST_COUNTRY, and related ablations."
    verification_status: unverified
    notes: "The DOI and complete author list resolve in search metadata, but the ACM primary landing page was not fetchable; search snippets are not treated as abstract verification."

  - id: wang-bias-in-the-shadows
    title: "Bias in the Shadows: Explore Shortcuts in Encrypted Network Traffic Classification"
    authors: "Chuyi Wang; Xiaohui Xie; Tongze Wang; Yong Cui"
    venue: "arXiv, 2026"
    year: 2026
    url: "https://arxiv.org/abs/2601.10180"
    arxiv_id: "2601.10180"
    category: hygiene-shortcut
    role: context
    relevance: "Introduces a model-agnostic, data-driven framework for detecting dataset-specific shortcut features and environment-entangled correlations. EIBO uses it to motivate feature hygiene and explicit environment-confound diagnostics."
    verification_status: verified-abstract
    notes: "The fetched arXiv title uses Explore, matching the brief; the abstract emphasizes BiasSeeker and evaluation across 19 public datasets."

  - id: luxemburk-cesnet-quic22
    title: "CESNET-QUIC22: a large one-month QUIC network traffic dataset from backbone lines"
    authors: "Jan Luxemburk; Karel Hynek; Tomáš Čejka; Andrej Lukačovič; Pavel Šiška"
    venue: "Data in Brief, 2023"
    year: 2023
    url: "https://doi.org/10.1016/j.dib.2023.108888"
    category: dataset
    role: dataset
    relevance: "Provides the one-month CESNET QUIC traffic benchmark and service labels used for replication and scale comparison. EIBO consumes it for the QUIC22 replication of prefix statistics and open-set detector validation."
    verification_status: verified-fulltext
    notes: "The fetched CESNET dataset record uses lowercase a in the title; the Data in Brief article is the DOI target and is dated 2023."

  - id: cesnet-quicext-25
    title: "CESNET-QUICEXT-25: A year-long QUIC traffic dataset with EXTended attributes"
    authors: "CESNET; associated paper cited by the record: Jan Mücke et al."
    venue: "Zenodo, 2025"
    year: 2025
    url: "https://zenodo.org/records/17249078"
    category: dataset
    role: dataset
    relevance: "Releases a year-long QUIC dataset with extended flow attributes, including client-version, country, ASN, and timing-related metadata. EIBO uses it for the paired environment-content separability design and the primary bracket study."
    verification_status: verified-fulltext
    notes: "The Zenodo record was fetched directly. The record is the dataset source; it cites Mücke et al.'s associated CoNEXT 2025 measurement paper."

  - id: ietf-rfc9312
    title: "RFC 9312: Manageability of the QUIC Transport Protocol"
    authors: "Mirja Kühlewind; Brian Trammell"
    venue: "IETF RFC 9312, 2022"
    year: 2022
    url: "https://datatracker.ietf.org/doc/rfc9312/"
    category: theory-foundation
    role: context
    relevance: "Documents the QUIC wire image, coalesced packets, observable fields, and operationally visible information. EIBO uses it to define the protocol-quotiented admissible observable alphabet before empirical implementation conditioning."
    verification_status: verified-fulltext
    notes: "The fetched RFC is Informational and was published in September 2022. It is protocol context, not a statistical lower-bound result."

  - id: smith-website-fingerprinting-quic
    title: "Website Fingerprinting in the Age of QUIC"
    authors: "Jean-Pierre Smith; Prateek Mittal; Adrian Perrig"
    venue: "Proceedings on Privacy Enhancing Technologies, 2021"
    year: 2021
    url: "https://netsec.ethz.ch/publications/papers/smith2021website.pdf"
    category: theory-foundation
    role: context
    relevance: "Empirically studies QUIC website fingerprinting, cross-protocol generalization, and feature behavior. EIBO uses it as QUIC traffic-analysis context and as motivation for implementation-conditioned rather than purely spec-conditioned assumptions."
    verification_status: verified-abstract
    notes: "The fetched PoPETs proceedings page verifies the title, authors, issue, pages, DOI, and abstract; the ETH PDF URL itself was not directly readable."

  - id: fang-learning-bounds-open-set
    title: "Learning Bounds for Open-Set Learning"
    authors: "Zhen Fang; Jie Lu; Anjin Liu; Feng Liu; Guangquan Zhang"
    venue: "Proceedings of Machine Learning Research (ICML), 2021"
    year: 2021
    url: "https://arxiv.org/abs/2106.15792"
    arxiv_id: "2106.15792"
    category: open-set
    role: context
    relevance: "Provides a generalization bound for open-set learning and introduces auxiliary open-set risk. EIBO uses it for open-set learning context while targeting information-theoretic pairwise limits rather than a training-risk bound."
    verification_status: verified-abstract
    notes: "The fetched arXiv record verifies the five-author list and the ICML-era open-set-learning contribution."

  - id: garov-ood-learnability
    title: "A Closer Look at the Learnability of Out-of-Distribution (OOD) Detection"
    authors: "Konstantin Garov; Kamalika Chaudhuri"
    venue: "arXiv, 2025"
    year: 2025
    url: "https://arxiv.org/abs/2501.08821"
    arxiv_id: "2501.08821"
    category: open-set
    role: context
    relevance: "Separates uniform and non-uniform learnability for OOD detection and gives sample-complexity analyses. EIBO uses it to frame unknown-service rejection as a learnability problem without conflating learnability guarantees with a TV-based error floor."
    verification_status: verified-abstract
    notes: "The fetched arXiv record verifies the two-author list and the stated learnability focus."

  - id: scheirer-toward-open-set
    title: "Toward Open Set Recognition"
    authors: "Walter J. Scheirer; Anderson de Rezende Rocha; Archana Sapkota; Terrance E. Boult"
    venue: "IEEE Transactions on Pattern Analysis and Machine Intelligence, 2013"
    year: 2013
    url: "https://doi.org/10.1109/tpami.2012.256"
    category: open-set
    role: context
    relevance: "Introduces the open-set recognition framing and risk of novel classes at deployment. EIBO uses it as the classical recognition context for its zero-unknown-calibration formulation."
    verification_status: unverified
    notes: "The DOI metadata was identified, but the IEEE primary landing page was not directly fetchable in this scan; author list is retained as verifiable bibliographic metadata with primary-page verification pending."

  - id: qu-sepspace
    title: "SepSpace: payload-free open-set network traffic classification via supervised contrastive representation learning and prototype-radius rejection"
    authors: "Yanze Qu; Chaofan Zheng; Minxi Liao; Hailong Ma; Yiming Jiang; Wenbo Wang"
    venue: "Cybersecurity, 2026"
    year: 2026
    url: "https://doi.org/10.1186/s42400-026-00635-x"
    category: positioning-competitor
    role: direct-competitor
    relevance: "Provides a payload-free open-set network traffic classifier using supervised contrastive representations and prototype-radius rejection. EIBO uses SepSpace as a deployed-detector baseline for per-service floor coverage validation."
    verification_status: verified-fulltext
    notes: "The Springer article page was fetched directly and exposes the complete six-author list, abstract, venue, and 2026 publication metadata."

  - id: wang-ronetc
    title: "Reliable Open-Set Network Traffic Classification (RoNeTC)"
    authors: "Xueman Wang; Yipeng Wang; Yingxu Lai; Zhiyu Hao; Alex X. Liu"
    venue: "IEEE Transactions on Information Forensics and Security, 2025"
    year: 2025
    url: "https://doi.org/10.1109/tifs.2025.3544067"
    category: positioning-competitor
    role: direct-competitor
    relevance: "Represents uncertainty-aware reliable open-set network traffic classification. EIBO uses RoNeTC as a detector baseline and compares observed rejection errors with the independently estimated epsilon bracket."
    verification_status: unverified
    notes: "The DOI and exact bibliographic metadata resolve in search results, but IEEE Xplore returned an access error for the primary page; search snippets are not treated as abstract verification."

  - id: shamsimukhametov-ech-indistinguishability
    title: "Indistinguishability of Traffic by Open TLS Parameters with Encrypted ClientHello"
    authors: "D. R. Shamsimukhametov; A. A. Kurapov; M. V. Liubogoshchev; E. M. Khorov"
    venue: "Journal of Communications Technology and Electronics, 2023"
    year: 2023
    url: "https://doi.org/10.1134/s1064226923120173"
    category: positioning-competitor
    role: direct-competitor
    relevance: "Studies traffic indistinguishability under open TLS parameters and Encrypted ClientHello. EIBO uses it as the closest protocol/privacy positioning comparator and motivates an SNI/ECH sensitivity analysis."
    verification_status: unverified
    notes: "The DOI-associated title, venue, date, and author list resolve in search metadata, but the Springer primary landing page was not directly fetchable; the entry remains unverified under the primary-record rule."
