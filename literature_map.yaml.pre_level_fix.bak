papers:
  cherubin2017bayes:
    title: 'Bayes, not Naïve: Security Bounds on Website Fingerprinting Defenses'
    authors:
    - Giovanni Cherubin
    year: 2017
    venue: Proceedings on Privacy Enhancing Technologies, 2017
    url: https://doi.org/10.1515/popets-2017-0046
    doi: ''
    bibtex_key: cherubin2017bayes
    category: theory-foundation
    role: foundation
    relevance: 'Provides feature-set-conditional Bayes-error bounds for website fingerprinting.
      EIBO uses this as the closed-set information-limit precedent that motivates
      pairwise error floors.


      The DOI landing page was not directly readable, but the PoPETs/arXiv record
      for the same paper was fetched and verified.'
    abstract: ''
    semantic_scholar_id: ''
    verified: true
    added_by: ''
    added_at: '2026-09-13T12:53:19.876Z'
    source_bibtex_key: cherubin-bayes-not-naive
  liu2026inevitability:
    title: The Inevitability of Side-Channel Leakage in Encrypted Traffic
    authors:
    - Guangjie Liu
    - Guang Cheng
    - Weiwei Liu
    year: 2026
    venue: arXiv, 2026
    url: https://arxiv.org/abs/2602.14055
    doi: ''
    bibtex_key: liu2026inevitability
    category: theory-foundation
    role: foundation
    relevance: 'Establishes a positive mutual-information side-channel existence theorem
      for encrypted traffic under explicit non-degeneracy and distinguishability conditions.
      EIBO uses it as the single-letter/i.i.d. positioning baseline against which
      dependent packet-prefix laws are tested.


      The abstract verifies the existence theorem and positive-information claim.
      Full HTML Section 4.1 verifies that additivity and exponential error decay require
      conditionally i.i.d. repeated observations; no broader multi-letter open-problem
      claim is used.'
    abstract: ''
    semantic_scholar_id: ''
    verified: true
    added_by: ''
    added_at: '2026-09-13T12:53:19.876Z'
    arxiv_id: '2602.14055'
    source_bibtex_key: liu-side-channel-leakage
  liu2026rate:
    title: Rate-Distortion Function for Encrypted Traffic Side-Channel Defense
    authors:
    - Guangjie Liu
    - Guang Cheng
    - Weiwei Liu
    - Yutong Wang
    year: 2026
    venue: arXiv, 2026
    url: https://arxiv.org/abs/2607.17889
    doi: ''
    bibtex_key: liu2026rate
    category: theory-foundation
    role: foundation
    relevance: 'Characterizes a side-channel rate-distortion function and an exact
      leakage-cost Pareto frontier within a stationary-memoryless defense class. EIBO
      uses this as the verified Theta_iid comparator, while extending attention to
      dependent QUIC prefixes.


      The abstract explicitly restricts the result to Theta_iid and states exact-frontier-within-Theta_iid.
      It does not need to support any claim about an open problem outside that class.'
    abstract: ''
    semantic_scholar_id: ''
    verified: true
    added_by: ''
    added_at: '2026-09-13T12:53:19.876Z'
    arxiv_id: '2607.17889'
    source_bibtex_key: liu-rate-distortion-side-channel
  michel2020high:
    title: High Probability Lower Bounds for the Total Variation Distance
    authors:
    - Loris Michel
    - Jeffrey Näf
    - Nicolai Meinshausen
    year: 2020
    venue: arXiv, 2020
    url: https://arxiv.org/abs/2005.06006
    doi: ''
    bibtex_key: michel2020high
    category: lower-bound-method
    role: method-component
    relevance: 'Develops classifier- and projection-based high-probability lower bounds
      on total variation distance. EIBO consumes the sup-over-cutoff construction
      for the assumption-free epsilon_k lower bracket, which certifies distinguishability
      rather than an error floor.


      The fetched arXiv record identifies an arXiv preprint; a peer-reviewed publication
      venue was not verified.'
    abstract: ''
    semantic_scholar_id: ''
    verified: true
    added_by: ''
    added_at: '2026-09-13T12:53:19.876Z'
    arxiv_id: '2005.06006'
    source_bibtex_key: michel-high-probability-tv
  tao2024discriminative:
    title: 'Discriminative Estimation of Total Variation Distance: A Fidelity Auditor
      for Generative Data'
    authors:
    - Lan Tao
    - Shirong Xu
    - Chi-Hua Wang
    - Namjoon Suh
    - Guang Cheng
    year: 2024
    venue: arXiv, 2024
    url: https://arxiv.org/abs/2405.15337
    doi: ''
    bibtex_key: tao2024discriminative
    category: tv-estimation
    role: method-component
    relevance: 'Relates discriminative estimation of total variation to Bayes classification
      risk and studies convergence under a specified hypothesis class, including Gaussian
      examples. EIBO uses it as a triangulation estimator between discrete plug-in
      bounds and larger-k model-based estimates.


      The fetched record says Fidelity Auditor for Generative Data, not the brief''s
      Fidelity Estimator for Generative Models. Its abstract does not provide a distribution-free
      upper confidence bound for EIBO.'
    abstract: ''
    semantic_scholar_id: ''
    verified: true
    added_by: ''
    added_at: '2026-09-13T12:53:19.876Z'
    arxiv_id: '2405.15337'
    source_bibtex_key: tao-discriminative-tv
  orlitsky2016optimal:
