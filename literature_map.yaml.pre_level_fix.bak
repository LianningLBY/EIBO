  zhao2025sweet:
    title: 'The Sweet Danger of Sugar: Debunking Representation Learning for Encrypted
      Traffic Classification'
    authors:
    - Yuqi Zhao
    - Giovanni Dettori
    - Matteo Boffa
    - Luca Vassio
    - Marco Mellia
    year: 2025
    venue: ACM SIGCOMM, 2025
    url: https://doi.org/10.1145/3718958.3750498
    doi: ''
    bibtex_key: zhao2025sweet
    category: hygiene-shortcut
    role: background
    relevance: 'Shows that representation-learning performance in encrypted traffic
      classification can be driven by shortcut features and leakage-prone data organization.
      EIBO uses it to require flow- and time-disjoint evaluation and to prohibit packet-level
      splitting.


      An arXiv version of the paper was fetched; the ACM DOI landing page itself was
      not directly readable.'
    abstract: ''
    semantic_scholar_id: ''
    verified: true
    added_by: ''
    added_at: '2026-09-13T12:53:19.876Z'
    source_bibtex_key: zhao-sweet-danger-sugar
